@page "/Account/Register"
@attribute [AllowAnonymous]
@rendermode InteractiveServer

@using System.ComponentModel.DataAnnotations
@using System.Text
@using System.Text.Encodings.Web
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.Extensions.Logging
@using AskEiva.Domain.Entities
@using AskEiva.WebUI.Components.Account
@using MudBlazor 

@inject UserManager<ApplicationUser> UserManager
@inject IUserStore<ApplicationUser> UserStore
@inject SignInManager<ApplicationUser> SignInManager
@inject IEmailSender<ApplicationUser> EmailSender
@inject ILogger<Register> Logger
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>EIVA | Register Node</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-16">
    <MudCard Elevation="0" Style="border: 1px solid #E2E8F0; border-radius: 4px;" Class="pa-8">
        
        <div class="text-center mb-6">
            <MudText Typo="Typo.h4" Class="font-weight-bold" Style="color: #0A2540;">AskEIVA</MudText>
            <MudText Typo="Typo.subtitle1" Style="color: #5B7083;">Authenticator</MudText>
        </div>

        <StatusMessage Message="@Message" />

        <EditForm Model="Input!" 
                  asp-route-returnUrl="@ReturnUrl" 
                  method="post" 
                  OnValidSubmit="RegisterUser" 
                  OnInvalidSubmit="LogFormErrors" 
                  FormName="register">
            <DataAnnotationsValidator />

            <div class="mb-4 text-left custom-validation-summary" style="color: #DC2626; font-size: 0.87rem;">
                <ValidationSummary />
            </div>

            <div class="d-flex flex-column gap-4">
                <MudTextField @bind-Value="Input!.Email" 
                             Label="Corporate Email" 
                             Variant="Variant.Outlined" 
                             Required="true" 
                             InputType="InputType.Email"
                             UserAttributes="@(new Dictionary<string, object> { { "name", "Input.Email" } })"
                             Placeholder="name@eiva.com"
                             For="@(() => Input!.Email)" />

                <MudTextField @bind-Value="Input!.Password" 
                             Label="Password" 
                             Variant="Variant.Outlined" 
                             Required="true" 
                             InputType="InputType.Password"
                             UserAttributes="@(new Dictionary<string, object> { { "name", "Input.Password" } })"
                             Placeholder="Password"
                             For="@(() => Input!.Password)" />

                <MudTextField @bind-Value="Input!.ConfirmPassword" 
                             Label="Confirm Password" 
                             Variant="Variant.Outlined" 
                             Required="true" 
                             InputType="InputType.Password"
                             UserAttributes="@(new Dictionary<string, object> { { "name", "Input.ConfirmPassword" } })"
                             Placeholder="Password"
                             For="@(() => Input!.ConfirmPassword)" />

                <MudButton ButtonType="ButtonType.Submit" 
                           Variant="Variant.Filled" 
                           Color="Color.Secondary" 
                           FullWidth="true" 
                           Class="py-3 mt-4" 
                           Style="Background-color:#C5DC22;font-weight: bold;">
                    Register Account
                </MudButton>
            </div>
        </EditForm>

        <div class="mt-8 pt-4 text-center" style="border-top: 1px solid #F1F5F9;">
            <MudText Typo="Typo.body2" Style="color: #5B7083;">
                Already have an authorized account? 
                <MudLink Href="Account/Login" Class="ml-1 font-weight-bold" Style="color: #0A2540;">Log In</MudLink>
            </MudText>
        </div>

    </MudCard>
</MudContainer>

@code {
    private IEnumerable<IdentityError>? identityErrors;

    /// <summary>
    /// Gets or sets the data model object bound to UI state properties.
    /// </summary>
    [SupplyParameterFromForm]
    private InputModel? Input { get; set; }

    /// <summary>
    /// Gets or sets the target landing destination path parameters after registration completes.
    /// </summary>
    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    /// <summary>
    /// Computes a singular string mapping any active identity pipeline validation crashes.
    /// </summary>
    private string? Message => identityErrors is null ? null : $"Error: {string.Join(", ", identityErrors.Select(error => error.Description))}";

    /// <summary>
    /// Instantiates localized form backing fields.
    /// </summary>
    protected override void OnInitialized()
    {
        Input ??= new();
    }

    /// <summary>
    /// Processes incoming form objects, calling the user manager pipeline to create and persist identity configurations inside Weaviate.
    /// </summary>
    /// <param name="editContext">The metadata state mapping context tracking fields inside the current form wrapper.</param>
    public async Task RegisterUser(EditContext editContext)
    {
        if (Input == null) return;

        var user = new ApplicationUser 
        { 
            Id = Guid.NewGuid().ToString(),
            Email = Input.Email 
        };
        
        // Persist user and verify password rules against Weaviate infrastructure
        var result = await UserManager.CreateAsync(user, Input.Password);

        if (!result.Succeeded)
        {
            identityErrors = result.Errors;
            return;
        }

        Logger.LogInformation("User created a new account with password in Weaviate.");

        // Establish an authenticated cookies tracking session token inside the browser client
        await SignInManager.SignInAsync(user, isPersistent: false);
        RedirectManager.RedirectTo(ReturnUrl);
    }

    /// <summary>
    /// Captures, logs, and dumps form validation failures to security diagnostic streams before dispatch requests drop.
    /// </summary>
    /// <param name="editContext">The data model state context holding active validation message objects.</param>
    public void LogFormErrors(EditContext editContext)
    {
        Logger.LogCritical("🚨 FORM SUBMISSION BLOCKED: Validation Failed Before Reaching RegisterUser!");
        
        foreach (var message in editContext.GetValidationMessages())
        {
            Logger.LogWarning("Validation Error: {ValidationMessage}", message);
        }
    }

    /// <summary>
    /// Local model containing field parameter mappings, formatting attributes, and input error text constraints.
    /// </summary>
    private sealed class InputModel
    {
        [Required(ErrorMessage = "Email is required.")]
        [EmailAddress(ErrorMessage = "Invalid corporate email address.")]
        [Display(Name = "Email")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Password is required.")]
        [StringLength(100, ErrorMessage = "The {0} must be at least {2} characters long.", MinimumLength = 6)]
        [DataType(DataType.Password)]
        [Display(Name = "Password")]
        public string Password { get; set; } = "";

        [DataType(DataType.Password)]
        [Display(Name = "Confirm password")]
        [Compare("Password", ErrorMessage = "The password and confirmation password do not match.")]
        public string ConfirmPassword { get; set; } = "";
    }
}